{
  "expo": {
    "name": "MyDietitian",
    "slug": "mydietitian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mydietitian",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.mydietitian.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "MyDietitian uses speech recognition to turn your voice into text.",
        "NSMicrophoneUsageDescription": "MyDietitian uses your microphone so you can answer questions and log meals by voice."
      }
    },
    "android": {
      "package": "com.mydietitian.app",
      "adaptiveIcon": {
        "backgroundColor": "#020101",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "MyDietitian uses your camera to scan meals, barcodes and ingredient labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MyDietitian needs access to your photos so you can log a meal from your gallery.",
          "cameraPermission": "MyDietitian uses your camera to photograph your meals.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MyDietitian uses your microphone so you can answer questions and log meals by voice.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MyDietitian uses your microphone so you can answer questions and log meals by voice.",
          "speechRecognitionPermission": "MyDietitian uses speech recognition to turn your voice into text.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MyDietitian uses your location once to set your country, city, currency and time zone."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#CA8A04",
          "defaultChannel": "default",
          "sounds": ["./assets/sounds/notification_sound.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ce41204-9557-4c79-bffb-6f3765ca5f86"
      }
    },
    "owner": "lalit_kumar_rai",
    "updates": {
      "url": "https://u.expo.dev/1ce41204-9557-4c79-bffb-6f3765ca5f86"
    }
  }
}
